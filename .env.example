# ==========================================
# REUP AUTOMATION - CONFIGURATION TEMPLATE
# ==========================================

# Server Settings
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Storage & Database
DATA_DIR=data
OUTPUT_DIR=outputs
TEMP_DIR=temp
DATABASE_URL=sqlite:///./data/reup_automation.db

# ------------------------------------------
# 1. AI Content & Translation Provider
# ------------------------------------------
# Supports OpenAI, ShopAIKey, 9Router, DeepSeek, Gemini, etc.
AI_BASE_URL=https://api.shopaikey.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Fallback models: gpt-4o-mini, gemini-1.5-flash, deepseek-chat

# ------------------------------------------
# 2. Audio ASR (Speech-to-Text) Provider
# ------------------------------------------
# Options: shopaikey, groq, openai, local
ASR_PROVIDER=shopaikey
ASR_API_KEY=
ASR_BASE_URL=https://api.shopaikey.com/v1
ASR_MODEL=whisper-1

# ------------------------------------------
# 3. Voice Dubbing (TTS) Provider
# ------------------------------------------
# Options: vbee (default, timestamp-synced), edge-tts
TTS_PROVIDER=vbee
# Vbee Official TTS API v1 credentials:
VBEE_APP_ID=63a47dd0-f273-4b4a-a9bf-ae354f38b554
VBEE_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3Nzg3NDA4MDN9.vSKa74Mutjtk6lGpEg2iuCItXZUrn9W9EBymYflEuXo
VBEE_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg
# Optional Vbee Studio cookie fallback:
VBEE_REFRESH_TOKEN_COOKIE=
# Edge-TTS fallback voice (Free, no token required): vi-VN-HoaiMyNeural or vi-VN-NamMinhNeural
EDGE_TTS_VOICE=vi-VN-HoaiMyNeural

# ------------------------------------------
# 4. E-Commerce & Cookies
# ------------------------------------------
DOUYIN_COOKIE=
SHOPEE_COOKIE=
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_SUB_ID=16550927460

# ------------------------------------------
# 5. Social Media Auto-Publishing
# ------------------------------------------
# Facebook Page Publishing (Reels & Standard Videos)
FACEBOOK_AUTO_PUBLISH=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Mode: reel or video
FACEBOOK_PUBLISH_MODE=reel

# TikTok Publishing
TIKTOK_AUTO_PUBLISH=false
TIKTOK_SESSION_ID=
TIKTOK_WEBHOOK_URL=
