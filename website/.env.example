# Cau hinh cong thanh toan VietQR (SePay / payOS) cho Reup Studio Portal
# Sao chep thanh `website/.env` tren may local hoac tren VPS (KHONG commit file .env len git).

PORTAL_PORT=8088
PORTAL_ADMIN_SECRET=change-this-admin-secret
PUBLIC_BASE_URL=http://127.0.0.1:8088
DOWNLOAD_REDIRECT_URL=

# Chon cong thanh toan: auto | sepay | payos
PAYMENT_PROVIDER=auto

# Tien to noi dung chuyen khoan rieng cho Reup Studio (RS -> RS123456789012)
# Khong trung voi CTV cua Co Tuong khi dung chung 1 tai khoan SePay!
PAYMENT_PREFIX=RS

# --- SePay (0 VND/thang, VietQR + tu dong doi soat qua Webhook hoac API Poll) ---
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
SEPAY_API_TOKEN=
SEPAY_API_BASE=

# --- payOS (tuy chon) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_BASE=
